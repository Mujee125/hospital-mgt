[package]
name = "vitalflow-keygen"
version = "0.1.0"
edition = "2021"
description = "VitalFlow HMS license key generation tools (offline, software-company use only)"
publish = false

# This crate is STANDALONE: it does NOT depend on `hospital_mgmt_lib` and is
# NOT built as part of the Tauri app. Run `cargo build --release` from this
# directory. The empty `[workspace]` section prevents Cargo from searching
# parent directories for a workspace root, so this crate is self-contained.
[workspace]

[[bin]]
name = "gen_keys"
path = "src/bin/gen_keys.rs"

[[bin]]
name = "sign_license"
path = "src/bin/sign_license.rs"

[[bin]]
name = "get_fingerprint"
path = "src/bin/get_fingerprint.rs"

[dependencies]
# ── Crypto — versions MUST match src-tauri/Cargo.toml exactly ───────────────
# If these drift, signatures produced by `sign_license` will FAIL to verify
# inside the app (license.rs::verify_signature).
ed25519-dalek = { version = "2", features = ["std", "rand_core"] }
rand_core     = { version = "0.6", features = ["std"] }   # OsRng for keygen
sha2          = "0.10"
hex           = "0.4"
base64        = "0.22"   # STANDARD engine — matches license.rs verify path

# ── Serialization ────────────────────────────────────────────────────────────
serde       = { version = "1", features = ["derive"] }
serde_json  = "1"

# ── Date/time for license issue/expiry timestamps ────────────────────────────
chrono      = { version = "0.4", features = ["serde"] }

# ── CLI argument parsing ─────────────────────────────────────────────────────
clap        = { version = "4", features = ["derive"] }

# ── Hardware fingerprinting — Windows-only (WMI). Gated to match ────────────
# src-tauri/Cargo.toml so non-Windows builds don't pull in the windows-rs stack.
[target.'cfg(target_os = "windows")'.dependencies]
wmi = "0.14"
