//! IT-001 + AERP Part G — shared integration-test infrastructure.
//!
//! Two test families share this module:
//!   1. Blood Bank suites (integration_tests, ipc_security_tests,
//!      concurrency_tests, scheduler_tests) — DB-level SQL tests.
//!   2. AERP Part G suites (whatsapp_authz_tests, session_tests,
//!      config_tests) — command/guard-level tests against the real
//!      migration + seed path.
//!
//! Database isolation: ALL tests run against a dedicated `hospital_db_test`
//! database (created/dropped by these helpers from the maintenance URL in
//! HMS_TEST_DB_URL). The production `hospital_db` is never touched.
//!
//! Tauri invocation: `mock_app()` builds a `tauri::test` mock-runtime App
//! with the real `PgPool` and `SessionState` managed inside it, so
//! `#[tauri::command]` fns that take `State<'_, T>` are invoked exactly as
//! the IPC layer invokes them.

#![allow(dead_code)]

use sqlx::PgPool;
use std::sync::{Arc, Mutex};

use hospital_mgmt_lib::rbac::{Session, SessionState};

// ── Test database lifecycle ──────────────────────────────────────────────────

fn maintenance_url() -> String {
    std::env::var("HMS_TEST_DB_URL").expect(
        "HMS_TEST_DB_URL must be set to the maintenance DB URL, e.g. \
         postgresql://postgres:<pw>@127.0.0.1:5432/postgres?sslmode=require",
    )
}

fn test_db_url() -> String {
    let url = maintenance_url();
    let (prefix, _db) = url
        .rsplit_once('/')
        .expect("HMS_TEST_DB_URL must end with a database name");
    format!("{}/hospital_db_test", prefix)
}

/// Connect to the maintenance database.
pub async fn maintenance_pool() -> PgPool {
    sqlx::postgres::PgPoolOptions::new()
        .max_connections(2)
        .connect(&maintenance_url())
        .await
        .expect("failed to connect to maintenance DB")
}

/// Provisioned-once marker: the DATABASE is created and migrated exactly
/// once per test process. Every test then gets its OWN fresh pool.
///
/// WHY NOT A SHARED POOL: each `#[tokio::test]` runs on its OWN runtime.
/// A static pool's connections are bound to the reactor of the runtime that
/// created them — when that test's runtime drops, its connections become
/// zombies checked out against a dead I/O driver. Every later checkout of
/// a zombie hangs, and the pool slowly exhausts (observed as 60s
/// PoolTimedOut cascades). The rule: share the DATABASE across tests,
/// never the POOL.
static DB_PROVISIONED: tokio::sync::OnceCell<()> = tokio::sync::OnceCell::const_new();

/// Per-test pool against the shared test database. Created on the CURRENT
/// test's runtime and dropped with it — no cross-runtime connections.
pub async fn test_pool() -> PgPool {
    DB_PROVISIONED
        .get_or_init(|| async { provision_once().await })
        .await;
    sqlx::postgres::PgPoolOptions::new()
        .max_connections(8)
        .acquire_timeout(std::time::Duration::from_secs(30))
        .connect(&test_db_url())
        .await
        .expect("connect to hospital_db_test")
}

/// Drop any leftover test DB from an earlier (possibly crashed) run, create
/// a fresh `hospital_db_test`, and run the REAL migrations + seed_defaults
/// — proving the actual init path, not a fixture copy.
///
/// SAFETY HARNESS: before migrating, this redirects the process's
/// `ProgramData` env var to a temp dir. `run_migrations` → `seed_defaults`
/// creates a bootstrap admin on the EMPTY test DB and writes
/// `bootstrap-credentials.txt` to `%ProgramData%\HMS` — without the
/// redirect, a test run on a machine WITH the real deployment would
/// clobber the production credentials file. All provisioning happens
/// inside the OnceCell init (before any parallel test proceeds), so the
/// env mutation has no concurrent readers.
pub async fn fresh_test_db() -> PgPool {
    let tmp_pd = std::env::temp_dir().join(format!("hms_test_programdata_{}", std::process::id()));
    std::fs::create_dir_all(&tmp_pd).ok();
    std::env::set_var("ProgramData", &tmp_pd);

    let maint = maintenance_pool().await;
    let _ = sqlx::query(
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity \
         WHERE datname = 'hospital_db_test' AND pid <> pg_backend_pid()",
    )
    .execute(&maint)
    .await;
    let _ = sqlx::query("DROP DATABASE IF EXISTS hospital_db_test")
        .execute(&maint)
        .await;
    sqlx::query("CREATE DATABASE hospital_db_test")
        .execute(&maint)
        .await
        .expect("failed to create hospital_db_test");
    maint.close().await;

    let pool = sqlx::postgres::PgPoolOptions::new()
        .max_connections(32)
        .acquire_timeout(std::time::Duration::from_secs(60))
        .connect(&test_db_url())
        .await
        .expect("failed to connect to hospital_db_test");

    hospital_mgmt_lib::db::run_migrations(&pool)
        .await
        .expect("run_migrations failed on test DB");
    pool
}

/// One-time provisioning. Uses short-lived pools that are fully closed
/// WITHIN this init — nothing reactor-bound escapes it.
async fn provision_once() {
    fresh_test_db().await;
}

/// Connect to an EXISTING test DB (no drop/create) — used by suites that run
/// after another suite already provisioned it within the same cargo test run.
pub async fn shared_pool() -> PgPool {
    let pool = sqlx::postgres::PgPoolOptions::new()
        .max_connections(8)
        .connect(&test_db_url())
        .await;
    match pool {
        Ok(p) => {
            // Idempotent: safe even if another binary already migrated.
            hospital_mgmt_lib::db::run_migrations(&p)
                .await
                .expect("run_migrations failed on test DB");
            p
        }
        Err(_) => fresh_test_db().await,
    }
}

/// Legacy alias used by the Blood Bank suites (IT-001).
pub async fn setup_pool() -> PgPool {
    shared_pool().await
}

// ── Mock Tauri app with real PgPool + SessionState ────────────────────────────

/// Build a mock-runtime Tauri app managing a real `PgPool` and a
/// `SessionState`. Commands invoked with `State` handles from this app run
/// the exact production code path (guards, SQL, audit) — only the webview
/// is simulated.
pub fn mock_app(pool: PgPool, session: Option<Session>) -> tauri::App<tauri::test::MockRuntime> {
    use tauri::Manager;
    let session_state: SessionState = Arc::new(Mutex::new(session));
    let app = tauri::test::mock_app();
    app.manage(pool);
    app.manage(session_state);
    app
}

// ── User / session / patient fixtures (AERP Part G) ──────────────────────────

/// Insert a user directly with a real Argon2id hash, attach roles by name,
/// return its id. Login-path hashing itself is covered by login_core tests.
/// Idempotent per (base) username: safe to call from multiple tests in one
/// process (ON CONFLICT reuses the row) — fixture users persist for the
/// lifetime of the shared test DB.
pub async fn seed_user(pool: &PgPool, username: &str, password: &str, roles: &[&str]) -> i32 {
    let hash = hospital_mgmt_lib::auth::hash_password(password).expect("hash fixture password");
    // Reuse an existing fixture row when present; Argon2 hashing only runs
    // for genuinely new users (m=19456 hashing dominates test runtime).
    if let Ok(row) = sqlx::query_as::<_, (i32,)>("SELECT id FROM users WHERE username = $1")
        .bind(username)
        .fetch_optional(pool)
        .await
    {
        if let Some((id,)) = row {
            return id;
        }
    }
    let hash = hospital_mgmt_lib::auth::hash_password(password).expect("hash fixture password");
    let row: (i32,) = sqlx::query_as(
        "INSERT INTO users (username, full_name, password_hash, is_active, must_change_password)
         VALUES ($1, $1, $2, TRUE, FALSE) RETURNING id",
    )
    .bind(username)
    .bind(&hash)
    .fetch_one(pool)
    .await
    .expect("seed user");
    for r in roles {
        sqlx::query(
            "INSERT INTO user_roles (user_id, role_id) \
             SELECT $1, id FROM roles WHERE name = $2 \
             ON CONFLICT DO NOTHING",
        )
        .bind(row.0)
        .bind(r)
        .execute(pool)
        .await
        .expect("attach role");
    }
    row.0
}

/// Load a real `Session` via the production loader — the exact code path
/// `login_core` uses after authentication (roles + permissions from DB).
pub async fn load_session_for(pool: &PgPool, user_id: i32, token_hash: &str) -> Session {
    hospital_mgmt_lib::auth::load_session(pool, user_id, token_hash)
        .await
        .expect("load_session fixture")
}

/// Insert a session row — fabricates "another PC's login" without the full
/// login command (mirrors login's INSERT exactly).
pub async fn seed_session_row(pool: &PgPool, user_id: i32, token_hash: &str) {
    sqlx::query(
        "INSERT INTO sessions (token_hash, user_id, expires_at) \
         VALUES ($1, $2, NOW() + INTERVAL '12 hours')",
    )
    .bind(token_hash)
    .bind(user_id)
    .execute(pool)
    .await
    .expect("seed session row");
}

pub async fn count_sessions(pool: &PgPool, user_id: i32) -> i64 {
    sqlx::query_scalar("SELECT COUNT(*) FROM sessions WHERE user_id = $1")
        .bind(user_id)
        .fetch_one(pool)
        .await
        .unwrap_or(0)
}

pub async fn set_user_active(pool: &PgPool, user_id: i32, active: bool) {
    sqlx::query("UPDATE users SET is_active = $1 WHERE id = $2")
        .bind(active)
        .bind(user_id)
        .execute(pool)
        .await
        .expect("set active");
}

pub async fn set_user_roles(pool: &PgPool, user_id: i32, roles: &[&str]) {
    sqlx::query("DELETE FROM user_roles WHERE user_id = $1")
        .bind(user_id)
        .execute(pool)
        .await
        .expect("clear roles");
    for r in roles {
        sqlx::query(
            "INSERT INTO user_roles (user_id, role_id) \
             SELECT $1, id FROM roles WHERE name = $2 \
             ON CONFLICT DO NOTHING",
        )
        .bind(user_id)
        .bind(r)
        .execute(pool)
        .await
        .expect("set role");
    }
}

/// Permission keys the DB currently grants a user through its roles.
pub async fn user_permission_keys(pool: &PgPool, user_id: i32) -> Vec<String> {
    let rows: Vec<(String,)> = sqlx::query_as(
        "SELECT DISTINCT p.key FROM permissions p \
         JOIN role_permissions rp ON rp.permission_id = p.id \
         JOIN user_roles ur ON ur.role_id = rp.role_id \
         WHERE ur.user_id = $1",
    )
    .bind(user_id)
    .fetch_all(pool)
    .await
    .expect("user perms");
    rows.into_iter().map(|r| r.0).collect()
}

/// Insert a patient row with a phone number (AERP Part G consent-gate tests).
pub async fn seed_patient_with_phone(pool: &PgPool, first: &str, last: &str, phone: &str) -> i32 {
    let row: (i32,) = sqlx::query_as(
        "INSERT INTO patients (first_name, last_name, phone, date_of_birth, gender) \
         VALUES ($1, $2, $3, '1990-01-01', 'male') RETURNING id",
    )
    .bind(first)
    .bind(last)
    .bind(phone)
    .fetch_one(pool)
    .await
    .expect("seed patient");
    row.0
}

/// Set a patient's WhatsApp consent (patient_consent table).
pub async fn set_consent(pool: &PgPool, patient_id: i32, granted: bool) {
    sqlx::query(
        "INSERT INTO patient_consent (patient_id, consent_type, granted) \
         VALUES ($1, 'whatsapp', $2) \
         ON CONFLICT (patient_id, consent_type) DO UPDATE SET granted = EXCLUDED.granted",
    )
    .bind(patient_id)
    .bind(granted)
    .execute(pool)
    .await
    .expect("set consent");
}

/// Seed a patient with blood_group + rh_factor (BE-01 columns). Returns id.
/// (Legacy IT-001 fixture — used by the Blood Bank suites. First-ever run
/// revealed the authored INSERT omitted NOT NULL phone/date_of_birth/gender;
/// fixed against the real schema 2026-09-02.)
pub async fn seed_patient(pool: &PgPool, blood_group: &str, rh_factor: &str) -> i32 {
    let row: (i32,) = sqlx::query_as(
        r#"INSERT INTO patients
               (first_name, last_name, phone, date_of_birth, gender, blood_group, rh_factor)
           VALUES ('Test', 'Patient', '92300000000', '1990-01-01', 'male', $1, $2)
           RETURNING id"#,
    )
    .bind(blood_group)
    .bind(rh_factor)
    .fetch_one(pool)
    .await
    .expect("Failed to seed patient");
    row.0
}

// ── Blood Bank fixtures (IT-001, preserved for the legacy suites) ─────────────

/// Seed a donor and return its id.
pub async fn seed_donor(pool: &PgPool, blood_group: &str, rh_factor: &str) -> i32 {
    let donor_number = format!("DON-TEST-{}", rand_u32());
    let row: (i32,) = sqlx::query_as(
        r#"INSERT INTO blood_donors
              (donor_number, first_name, last_name, blood_group, rh_factor, status)
           VALUES ($1, 'Test', 'Donor', $2, $3, 'active') RETURNING id"#,
    )
    .bind(&donor_number)
    .bind(blood_group)
    .bind(rh_factor)
    .fetch_one(pool)
    .await
    .expect("Failed to seed donor");
    row.0
}

/// Seed a donation + linked quarantine blood unit. Returns (donation_id, unit_id).
pub async fn seed_donation_and_unit(
    pool: &PgPool,
    donor_id: i32,
    blood_group: &str,
    rh_factor: &str,
) -> (i32, i32) {
    let mut tx = pool.begin().await.expect("Failed to begin tx");

    let donation_number = format!("BDN-TEST-{}", rand_u32());
    let donation_row: (i32,) = sqlx::query_as(
        r#"INSERT INTO blood_donations
              (donation_number, donor_id, volume_ml, blood_group, rh_factor,
               status, screening_status)
           VALUES ($1, $2, 450, $3, $4, 'collected', 'pending') RETURNING id"#,
    )
    .bind(&donation_number)
    .bind(donor_id)
    .bind(blood_group)
    .bind(rh_factor)
    .fetch_one(&mut *tx)
    .await
    .expect("Failed to seed donation");
    let donation_id = donation_row.0;

    let unit_number = format!("BU-TEST-{}", rand_u32());
    let unit_row: (i32,) = sqlx::query_as(
        r#"INSERT INTO blood_units
              (unit_number, donation_id, donor_id, component_type, blood_group, rh_factor,
               volume_ml, collection_date, expiry_date, status)
           VALUES ($1, $2, $3, 'whole_blood', $4, $5, 450, NOW(),
                   NOW() + INTERVAL '35 days', 'quarantine') RETURNING id"#,
    )
    .bind(&unit_number)
    .bind(donation_id)
    .bind(donor_id)
    .bind(blood_group)
    .bind(rh_factor)
    .fetch_one(&mut *tx)
    .await
    .expect("Failed to seed unit");
    let unit_id = unit_row.0;

    tx.commit().await.expect("Failed to commit seed");
    (donation_id, unit_id)
}

/// Mark a donation's screening as passed and release the unit to 'available'.
pub async fn pass_screening(pool: &PgPool, donation_id: i32) {
    sqlx::query(
        "UPDATE blood_donations SET screening_status = 'passed', status = 'screened' WHERE id = $1",
    )
    .bind(donation_id)
    .execute(pool)
    .await
    .expect("Failed to update screening");
    sqlx::query("UPDATE blood_units SET status = 'available' WHERE donation_id = $1")
        .bind(donation_id)
        .execute(pool)
        .await
        .expect("Failed to release unit");
}

/// Expire a unit (BE-02 tests).
pub async fn expire_unit(pool: &PgPool, unit_id: i32) {
    sqlx::query("UPDATE blood_units SET expiry_date = NOW() - INTERVAL '1 hour' WHERE id = $1")
        .bind(unit_id)
        .execute(pool)
        .await
        .expect("Failed to expire unit");
}

pub async fn count_audit_entries(pool: &PgPool, action: &str, resource_id: &str) -> i64 {
    sqlx::query_scalar("SELECT COUNT(*) FROM audit_logs WHERE action = $1 AND resource_id = $2")
        .bind(action)
        .bind(resource_id)
        .fetch_one(pool)
        .await
        .unwrap_or(0)
}

pub async fn count_history_entries(pool: &PgPool, unit_id: i32) -> i64 {
    sqlx::query_scalar("SELECT COUNT(*) FROM blood_unit_status_history WHERE unit_id = $1")
        .bind(unit_id)
        .fetch_one(pool)
        .await
        .unwrap_or(0)
}

pub async fn count_movement_entries(pool: &PgPool, unit_id: i32) -> i64 {
    sqlx::query_scalar("SELECT COUNT(*) FROM blood_inventory_movements WHERE unit_id = $1")
        .bind(unit_id)
        .fetch_one(pool)
        .await
        .unwrap_or(0)
}

pub async fn get_unit_status(pool: &PgPool, unit_id: i32) -> String {
    let row: (String,) = sqlx::query_as("SELECT status FROM blood_units WHERE id = $1")
        .bind(unit_id)
        .fetch_one(pool)
        .await
        .expect("Unit not found");
    row.0
}

fn rand_u32() -> u32 {
    use std::time::SystemTime;
    let now = SystemTime::now()
        .duration_since(SystemTime::UNIX_EPOCH)
        .unwrap()
        .subsec_nanos();
    now.wrapping_add(unsafe { std::arch::x86_64::_rdtsc() as u32 })
}
