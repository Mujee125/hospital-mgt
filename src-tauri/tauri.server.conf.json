{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HMS Server",
  "identifier": "com.hospital.mgmt.server",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "beforeBuildCommand": "npm run build:server"
  },
  "bundle": {
    "resources": {
      "resources/pgsql": "pgsql"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
