{
  "name": "hospital-mgmt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env VITE_HMS_BUILD_MODE=server vite",
    "dev:client": "cross-env VITE_HMS_BUILD_MODE=client vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:server": "cross-env VITE_HMS_BUILD_MODE=server tsc --noEmit && cross-env VITE_HMS_BUILD_MODE=server vite build",
    "build:client": "cross-env VITE_HMS_BUILD_MODE=client tsc --noEmit && cross-env VITE_HMS_BUILD_MODE=client vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "dev:license": "cargo run --manifest-path src-tauri/Cargo.toml --bin dev_auto_license",
    "gen:prod-license": "cargo run --manifest-path src-tauri/Cargo.toml --bin gen_production_license",
    "tauri:dev:server": "npm run dev:license && cross-env VITE_HMS_BUILD_MODE=server tauri dev -- --features server-build --config src-tauri/tauri.server.conf.json",
    "tauri:dev:client": "npm run dev:license && cross-env VITE_HMS_BUILD_MODE=client tauri dev -- --features client-build --config src-tauri/tauri.client.conf.json",
    "tauri:dev": "npm run dev:license && tauri dev",
    "tauri:build:server": "cross-env VITE_HMS_BUILD_MODE=server tauri build --features server-build --config src-tauri/tauri.server.conf.json",
    "tauri:build:client": "cross-env VITE_HMS_BUILD_MODE=client tauri build --features client-build --config src-tauri/tauri.client.conf.json"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "motion": "^11.15.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
